#!/usr/bin/env python3
"""Cross-platform launcher for the knowledge base engine.

    ./kb search "patroni etcd"
    ./kb --kb ~/.dsh/kb/default stats

Equivalent to `python kb.py ...`; it exists so the skill works on macOS and Linux
where the PowerShell wrapper is not available.
"""
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ENGINE = HERE / "kb.py"

if not ENGINE.is_file():
    sys.exit(f"kb: engine not found next to this launcher: {ENGINE}")

os.execv(sys.executable, [sys.executable, str(ENGINE), *sys.argv[1:]])
